# Chave da API da Anthropic (Claude). Sem ela o ReadmeCraft usa o gerador por templates (modo offline).
# Também aceita credenciais de `ant auth login` (perfil OAuth) — basta deixar em branco.
ANTHROPIC_API_KEY=

# Modelo Claude usado na geração (padrão: claude-haiku-4-5)
ANTHROPIC_MODEL=claude-haiku-4-5

# Token pessoal do GitHub (opcional). Aumenta o rate limit de 60 para 5000 req/h.
# Use um fine-grained token SOMENTE com acesso de leitura a repositórios públicos.
GITHUB_TOKEN=

# Porta do servidor de API
PORT=8787

# Orçamento global de gerações por dia (protege o custo da API)
GENERATE_DAILY_LIMIT=500

# Defina 1 somente atrás de um proxy reverso confiável (usa o IP mais à direita do X-Forwarded-For)
TRUST_PROXY=

# --- Login com GitHub (publicar README via Pull Request) ---
# Crie um OAuth App em https://github.com/settings/developers
# Authorization callback URL: <APP_URL>/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# URL pública do app (local: http://localhost:5173)
APP_URL=http://localhost:5173
# Segredo para cifrar o cookie de sessão (mín. 32 caracteres): openssl rand -base64 48
SESSION_SECRET=

# --- Histórico na conta (Supabase) — exige o login com GitHub acima ---
SUPABASE_URL=https://gvzkwqfdgohdlvjupvgq.supabase.co
# Chave SECRETA (sb_secret_...) em Project Settings > API Keys. Fica só no servidor.
SUPABASE_SECRET_KEY=
